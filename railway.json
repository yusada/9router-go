{
  "$schema": "https://railway.com/railway.schema.json",
  "name": "9router-go",
  "description": "High-performance Go proxy gateway for 9Router LLM routing",
  "tags": ["ai", "golang", "router", "llm", "proxy"],
  "services": {
    "app": {
      "name": "9router-go",
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "./Dockerfile"
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
      },
      "variables": {
        "PORT": {
          "description": "Port for the application",
          "defaultValue": "8080"
        }
      }
    }
  }
}
